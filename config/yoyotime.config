# Shared contract with MomentStamp exports. Read strings without date conversion.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        yoyo => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::yoyo' } },
    },
);
%Image::ExifTool::UserDefined::yoyo = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-yoyo', 2 => 'Image' },
    NAMESPACE => { yoyo => 'urn:momentstamp:yoyo:1.0:' },
    WRITABLE => 'string',
    yoyotime => { Name => 'yoyotime', Groups => { 2 => 'Time' } },
    yoyotimeSource => { Name => 'yoyotimeSource' },
    yoyotimeRawValue => { Name => 'yoyotimeRawValue' },
);
1;
