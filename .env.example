# Copy to .env.local; real credentials must never be committed.
# Public project identity; not a password.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Restricted SQL LOGIN role granted momentnest_app. Never use postgres here.
DATABASE_URL=
# Include project ref to prevent accidentally connecting to another project.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
APP_URL=http://localhost:3000
# Confirmed production origin; set only in the deployed environment after HTTPS is ready:
# APP_URL=https://nest.rokzhang.cn
# Production DB TLS always verifies certificates; optional trusted CA PEM path.
DATABASE_CA_FILE=config/certs/supabase-prod-ca-2021.crt

# Local private media (not a public/static directory).
MEDIA_ROOT=.private/media
MEDIA_PUBLIC_URL=http://localhost:3001
MEDIA_BIND=127.0.0.1
MEDIA_PORT=3001
# Bundled ExifTool reads MomentStamp yoyotime XMP; requires Perl on the host.
# PERL_PATH=/usr/bin/perl
# Generate at least 32 random bytes; server-only, never NEXT_PUBLIC_.
MEDIA_SIGNING_SECRET=
# Dedicated LOGIN member of momentnest_worker, not the application/admin role.
WORKER_DATABASE_URL=
BACKUP_ROOT=.private/backups
